@page "/"

<PageTitle>Smart Buzz Wire</PageTitle>

<div class="home-hero mb-4">
	<p class="home-kicker">Internet of Things · Smart Buzz Wire</p>
	<h1>Steady hands win.</h1>
	<p class="lead mb-0">
		Scan your card, follow the wire fast and without touching it, and collect the most points.
	</p>
</div>

<LivePanel />

<h2 class="section-title">How to play</h2>
<div class="steps mb-4">
	<div class="step"><span class="step-no step-red">1</span><b>Red button</b><span>new player</span></div>
	<div class="step"><span class="step-no">2</span><b>Scan card</b><span>RFID reader</span></div>
	<div class="step"><span class="step-no">3</span><b>Touch start</b><span>errors = 0</span></div>
	<div class="step"><span class="step-no">4</span><b>Follow the wire</b><span>every touch = error</span></div>
	<div class="step"><span class="step-no">5</span><b>Touch stop</b><span>time is saved</span></div>
</div>
<div class="score-rule mb-4">🏆 Points = @ScoreCalculator.Rule – one error costs as much as 1 second.</div>

<h2 class="section-title">Pages</h2>
<div class="row g-3">
	<div class="col-12 col-md-6 col-lg-4">
		<a class="home-card text-decoration-none" href="scoreboard">
			<span class="home-card-icon">🏆</span>
			<h5>Scoreboard</h5>
			<p>Best runs by points (time and errors).</p>
		</a>
	</div>

	<div class="col-12 col-md-6 col-lg-4">
		<a class="home-card text-decoration-none" href="track">
			<span class="home-card-icon">〰️</span>
			<h5>Track</h5>
			<p>Calibrated course and replay of the best run.</p>
		</a>
	</div>

	<div class="col-12 col-md-6 col-lg-4">
		<a class="home-card text-decoration-none" href="players">
			<span class="home-card-icon">👤</span>
			<h5>Players</h5>
			<p>Create players and assign their RFID cards.</p>
		</a>
	</div>
</div>
