@page "/track"

@using Hotwire.Web.Web.Data
@using Hotwire.Web.Web.Services
@using Hotwire.Web.Web.Models
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text.Json

@inject IDbContextFactory<GameDbContext> DbFactory
@inject IWebHostEnvironment Env
@inject CalibrationStateService CalibrationState
@inject LiveGameState Live
@implements IDisposable

<div class="page-header">
	<h1 class="page-title">Track</h1>
	<p class="page-subtitle">Calibration contour and best-run replay for the active track.</p>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
	<div class="alert alert-danger">@ErrorMessage</div>
}
else if (Calibration is null)
{
	<p>Loading calibration data...</p>
}
else
{
	<div class="alert alert-success">Calibration loaded.</div>

	<div class="meta-grid">
		<div class="meta-item">
			<span class="meta-label">Track</span>
			<span class="meta-value">@Calibration.TrackName</span>
		</div>
		<div class="meta-item">
			<span class="meta-label">Points</span>
			<span class="meta-value">@Calibration.Points.Count</span>
		</div>
	</div>

	<div class="page-actions">
		<button class="btn btn-primary" @onclick="() => LoadAndPlayAsync(best: false)" disabled="@IsReplayRunning">
			▶ Replay last run
		</button>
		<button class="btn btn-outline-primary" @onclick="() => LoadAndPlayAsync(best: true)" disabled="@IsReplayRunning">
			🏆 Replay best run
		</button>
		<button class="btn btn-success" @onclick="StartReplayAsync" disabled="@(ScaledReplayPoints.Count < 2 || IsReplayRunning)">
			Replay again
		</button>
		<button class="btn btn-outline-secondary" @onclick="StopReplay" disabled="@(!IsReplayRunning)">
			Stop Replay
		</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(ReplayMessage))
	{
		<div class="alert alert-info">@ReplayMessage</div>
	}

	@if (CalibrationState.ActiveCalibrationId is not null)
	{
		<div class="meta-grid">
			<div class="meta-item">
				<span class="meta-label">Active Calibration ID</span>
				<span class="meta-value">@CalibrationState.ActiveCalibrationId</span>
			</div>
			<div class="meta-item">
				<span class="meta-label">Active Calibration Name</span>
				<span class="meta-value">@CalibrationState.ActiveCalibrationName</span>
			</div>
		</div>
	}

	@if (Calibration.Points.Count > 1)
	{
		<div class="meta-grid">
			<div class="meta-item">
				<span class="meta-label">First timestamp</span>
				<span class="meta-value">@Calibration.Points.First().Timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss.fff 'UTC'")</span>
			</div>
			<div class="meta-item">
				<span class="meta-label">Last timestamp</span>
				<span class="meta-value">@Calibration.Points.Last().Timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss.fff 'UTC'")</span>
			</div>
		</div>

		<div class="track-canvas mt-2">
			<svg viewBox="0 0 1000 700" style="width:100%; height:70vh;">
				<polyline points="@PolylinePoints"
						  fill="none"
						  stroke="#1b6ec2"
						  stroke-width="3"
						  stroke-linejoin="round"
						  stroke-linecap="round"/>

				@if (ScaledReplayPoints.Count > 1)
				{
					<polyline points="@ReplayPolylinePoints"
							  fill="none"
							  stroke="#dc3545"
							  stroke-width="2"
							  stroke-linejoin="round"
							  stroke-linecap="round"
							  stroke-dasharray="6 4" />
				}

				@* Real wire touches of the loaded run (red X) *@
				@foreach (var c in CollisionMarkers)
				{
					<circle cx="@F(c.X)" cy="@F(c.Y)" r="11" fill="#e5484d" fill-opacity="0.18" stroke="#e5484d" stroke-width="2" />
					<line x1="@F(c.X - 6)" y1="@F(c.Y - 6)" x2="@F(c.X + 6)" y2="@F(c.Y + 6)" stroke="#e5484d" stroke-width="3" stroke-linecap="round" />
					<line x1="@F(c.X - 6)" y1="@F(c.Y + 6)" x2="@F(c.X + 6)" y2="@F(c.Y - 6)" stroke="#e5484d" stroke-width="3" stroke-linecap="round" />
				}

				@if (ReplayDotX is not null && ReplayDotY is not null)
				{
					@if (IsCollisionFrame)
					{
						<circle cx="@ReplayDotXText"
								cy="@ReplayDotYText"
								r="14"
								fill="#ff4d4f"
								fill-opacity="0.32">
							<animate attributeName="r"
									 from="14"
									 to="24"
									 dur="220ms"
									 begin="0s"
									 fill="freeze" />
							<animate attributeName="fill-opacity"
									 from="0.32"
									 to="0"
									 dur="220ms"
									 begin="0s"
									 fill="freeze" />
						</circle>
					}

					<circle cx="@ReplayDotXText"
							cy="@ReplayDotYText"
							r="10"
							fill="@ReplayDotFillColor"
							stroke="white"
							stroke-width="3" />
				}

				@* Live position of the red tip while a run (or calibration) is going on *@
				@if (LiveDot is not null)
				{
					<circle cx="@F(LiveDot.Value.X)" cy="@F(LiveDot.Value.Y)" r="22"
							fill="none" stroke="#18a058" stroke-width="3" stroke-opacity="0.4" />
					<circle cx="@F(LiveDot.Value.X)" cy="@F(LiveDot.Value.Y)" r="12"
							fill="#18a058" stroke="white" stroke-width="3" />
				}
			</svg>
		</div>
	}
}

@code {
	private const double SvgWidth = 1000;
	private const double SvgHeight = 700;
	private const double Padding = 30;

	private CalibrationData? Calibration;
	private int? BestRunId;
	private string? ReplayMessage;
	private string? ErrorMessage;
	private bool IsReplayRunning;
	private CancellationTokenSource? ReplayCts;
	private double? ReplayDotX;
	private double? ReplayDotY;

	private string PolylinePoints =>
		string.Join(" ", ScaledPoints.Select(p =>
			$"{p.X.ToString("F2", CultureInfo.InvariantCulture)}," +
			$"{p.Y.ToString("F2", CultureInfo.InvariantCulture)}"));
	private string ReplayPolylinePoints =>
		string.Join(" ", ScaledReplayPoints.Select(p =>
			$"{p.X.ToString("F2", CultureInfo.InvariantCulture)},"+
			$"{p.Y.ToString("F2", CultureInfo.InvariantCulture)}"));

	private string ReplayDotXText => (ReplayDotX ?? 0d).ToString("F2", CultureInfo.InvariantCulture);
	private string ReplayDotYText => (ReplayDotY ?? 0d).ToString("F2", CultureInfo.InvariantCulture);
	private string ReplayDotFillColor => IsCollisionFrame ? "#ff4d4f" : "#1b6ec2";


	private List<(double X, double Y)> ScaledPoints = [];
	private List<(double X, double Y)> ScaledReplayPoints = [];
	private List<PositionData> BestRunPositions = [];
	private HashSet<int> CollisionReplayIndices = [];
	private int ReplayCollisionCount;
	private bool IsCollisionFrame;

	protected override async Task OnInitializedAsync()
	{
		await LoadCalibrationAsync();
		Live.Changed += OnLiveChanged;
	}

	private async Task LoadCalibrationAsync()
	{
		try
		{
			var filePath = Path.Combine(Env.WebRootPath, "data", "calibration.json");

			if (!File.Exists(filePath))
			{
				ErrorMessage = $"File not found";
				return;
			}

			await using var stream = File.OpenRead(filePath);
			Calibration = await JsonSerializer.DeserializeAsync<CalibrationData>(stream, new JsonSerializerOptions
			{
				PropertyNameCaseInsensitive = true
			});

			if (Calibration is null)
			{
				ErrorMessage = "JSON could not be deserialized";
			}

			if (Calibration is not null)
			{
				await using var db = await DbFactory.CreateDbContextAsync();

				var calibration = await db.TrackCalibration
					.FirstOrDefaultAsync(c => c.Name == Calibration.TrackName);

				if (calibration is null)
				{
					calibration = new TrackCalibration
					{
						Name = Calibration.TrackName,
						CreatedAt = DateTime.UtcNow
					};

					db.TrackCalibration.Add(calibration);
					await db.SaveChangesAsync();
				}

				CalibrationState.SetActiveCalibration(calibration.Id, calibration.Name);

				BuildScaledPoints();
			}
		}
		catch (Exception ex)
		{
			ErrorMessage = $"Error: {ex.Message}";
		}
	}

	// Green live dot: only while a run or calibration is active and the marker is visible
	private (double X, double Y)? LiveDot =>
		ScaledPoints.Count > 0 && (Live.IsRunActive || CalibrationState.IsRecording) &&
		Live.LastPosition is not null &&
		(DateTime.UtcNow - Live.LastPosition.TimestampUtc).TotalSeconds < 1
			? ToSvg((Live.LastPosition.X, Live.LastPosition.Y))
			: null;

	private static string F(double v) => v.ToString("F1", CultureInfo.InvariantCulture);

	private void OnLiveChanged() => InvokeAsync(StateHasChanged);

	public void Dispose()
	{
		Live.Changed -= OnLiveChanged;
		StopReplay();
	}

	// Load the last or the best run of the active track and play it right away
	private async Task LoadAndPlayAsync(bool best)
	{
		await LoadReplayAsync(best);
		if (ScaledReplayPoints.Count >= 2)
		{
			await StartReplayAsync();
		}
	}

	private async Task LoadReplayAsync(bool best)
	{
		if (CalibrationState.ActiveCalibrationId is null)
		{
			ReplayMessage = "No active calibration selected.";
			return;
		}

		await using var db = await DbFactory.CreateDbContextAsync();

		var runs = db.GameRuns.Where(r => r.Completed &&
						r.CalibrationId == CalibrationState.ActiveCalibrationId.Value);

		// best = fastest run, otherwise the newest run
		var bestRun = best
			? await runs.OrderBy(r => r.Duration).FirstOrDefaultAsync()
			: await runs.OrderByDescending(r => r.Id).FirstOrDefaultAsync();

		if (bestRun is null)
		{
			BestRunId = null;
			BestRunPositions = [];
			ReplayCollisionCount = 0;
			CollisionReplayIndices.Clear();
			CollisionMarkers.Clear();
			CleanReplay = [];
			UpdateScale();
			IsCollisionFrame = false;
			ReplayMessage = "No finished run on this track yet – play one first (runs from older tracks are not shown).";
			return;
		}

		BestRunId = bestRun.Id;

		BestRunPositions = await db.PositionDatas
			.Where(p => p.GameRunId == bestRun.Id)
			.OrderBy(p => p.TimeStamp)
			.ToListAsync();

		ReplayCollisionCount = Math.Max(0, bestRun.Collisions ?? 0);
		BuildScaledReplayPoints();

		var touches = await db.CollisionPoints
			.Where(c => c.GameRunId == bestRun.Id)
			.OrderBy(c => c.TimeStamp)
			.ToListAsync();
		BuildCollisionReplayIndices(touches);
		IsReplayRunning = false;
		ReplayDotX = null;
		ReplayDotY = null;
		IsCollisionFrame = false;

		var label = best ? "Best run" : "Last run";
		ReplayMessage = BestRunPositions.Count == 0
			? $"{label} #{bestRun.Id} found, but without position data (was the camera running?)."
			: $"{label} #{bestRun.Id}: {bestRun.Duration:0.00} s, {bestRun.Collisions ?? 0} errors" +
			  (touches.Count > 0 ? " – red X = where the wire was touched." : ".");
	}

	private async Task StartReplayAsync()
	{
		if (BestRunPositions.Count < 2 || ScaledReplayPoints.Count < 2)
		{
			ReplayMessage = "No replay data loaded.";
			return;
		}

		StopReplay();
		ReplayCts = new CancellationTokenSource();
		var token = ReplayCts.Token;

		IsReplayRunning = true;
		ReplayDotX = ScaledReplayPoints[0].X;
		ReplayDotY = ScaledReplayPoints[0].Y;
		IsCollisionFrame = CollisionReplayIndices.Contains(0);
		await InvokeAsync(StateHasChanged);

		try
		{
			for (int i = 1; i < BestRunPositions.Count; i++)
			{
				token.ThrowIfCancellationRequested();

				var prev = BestRunPositions[i - 1].TimeStamp;
				var curr = BestRunPositions[i].TimeStamp;
				var delay = curr - prev;

				if (delay < TimeSpan.Zero) delay = TimeSpan.Zero;
				if (delay > TimeSpan.FromMilliseconds(250)) delay = TimeSpan.FromMilliseconds(250);

				await Task.Delay(delay, token);
				ReplayDotX = ScaledReplayPoints[i].X;
				ReplayDotY = ScaledReplayPoints[i].Y;
				IsCollisionFrame = CollisionReplayIndices.Contains(i);
				await InvokeAsync(StateHasChanged);
			}

			ReplayMessage = "Replay finished.";
		}
		catch (OperationCanceledException)
		{
			ReplayMessage = "Replay stopped.";
		}
		finally
		{
			IsReplayRunning = false;
			ReplayDotX = null;
			ReplayDotY = null;
			IsCollisionFrame = false;
			ReplayCts?.Dispose();
			ReplayCts = null;
			await InvokeAsync(StateHasChanged);
		}
	}

	// Red X on the track for every real wire touch
	private List<(double X, double Y)> CollisionMarkers = [];

	// Real touches: each one is placed at the replay point closest in time,
	// so the replay dot flashes red exactly when the wire was touched.
	private void BuildCollisionReplayIndices(List<CollisionPoint> touches)
	{
		CollisionReplayIndices.Clear();
		CollisionMarkers.Clear();

		if (BestRunPositions.Count < 2 || ScaledReplayPoints.Count != BestRunPositions.Count)
		{
			return;
		}

		foreach (var touch in touches)
		{
			var index = 0;
			for (var i = 1; i < BestRunPositions.Count; i++)
			{
				if ((BestRunPositions[i].TimeStamp - touch.TimeStamp).Duration() <
					(BestRunPositions[index].TimeStamp - touch.TimeStamp).Duration())
				{
					index = i;
				}
			}

			CollisionReplayIndices.Add(index);
			CollisionMarkers.Add(ScaledReplayPoints[index]);
		}
	}

	private void StopReplay()
	{
		ReplayCts?.Cancel();
	}

	// Scale + offset so that the track AND the loaded run fit into the picture
	private double MinX, MaxX, MinY, Scale, OffsetX, OffsetY;

	// Cleaned camera points (before scaling)
	private List<(double X, double Y)> CleanContour = [];
	private List<(double X, double Y)> CleanReplay = [];

	// Camera pixel -> SVG point. The camera looks at the course from the front,
	// so left/right is mirrored back (MaxX - x). Camera y grows downwards like SVG.
	private (double X, double Y) ToSvg((double X, double Y) p)
	{
		var x = OffsetX + (MaxX - p.X) * Scale;
		var y = OffsetY + (p.Y - MinY) * Scale;
		return (x, y);
	}

	// Fit all points (track + replay) into the SVG and scale both lines again
	private void UpdateScale()
	{
		var all = CleanContour.Concat(CleanReplay).ToList();
		if (all.Count == 0) return;

		MinX = all.Min(p => p.X);
		MaxX = all.Max(p => p.X);
		MinY = all.Min(p => p.Y);
		var maxY = all.Max(p => p.Y);

		var srcWidth = Math.Max(1, MaxX - MinX);
		var srcHeight = Math.Max(1, maxY - MinY);

		var targetWidth = SvgWidth - (2 * Padding);
		var targetHeight = SvgHeight - (2 * Padding);

		Scale = Math.Min(targetWidth / srcWidth, targetHeight / srcHeight);
		OffsetX = (SvgWidth - srcWidth * Scale) / 2.0;
		OffsetY = (SvgHeight - srcHeight * Scale) / 2.0;

		ScaledPoints = CleanContour.Select(ToSvg).ToList();
		ScaledReplayPoints = CleanReplay.Select(ToSvg).ToList();
	}

	private void BuildScaledPoints()
	{
		CleanContour = [];

		if (Calibration is not null && Calibration.Points.Count > 0)
		{
			// Keep the contour in real capture order (timestamp), then remove outliers and smooth
			CleanContour = TrackSmoothing.Clean(Calibration.Points
				.OrderBy(p => p.Timestamp)
				.Select(p => (p.X, p.Y))
				.ToList());
		}

		UpdateScale();
	}

	private void BuildScaledReplayPoints()
	{
		// Same cleaning as the contour; the point count stays the same,
		// so replay timing and collision frames still fit
		CleanReplay = BestRunPositions.Count == 0 ? [] : TrackSmoothing.Clean(BestRunPositions
			.Select(p => ((double)p.X, (double)p.Y))
			.ToList());

		UpdateScale();
	}

	private sealed class CalibrationData
	{
		public string TrackName { get; set; } = "";
		public List<TrackPoint> Points { get; set; } = [];
	}

	private sealed class TrackPoint
	{
		public double X { get; set; }
		public double Y { get; set; }
		public DateTime Timestamp { get; set; }
	}
}
